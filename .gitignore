bin/
obj/

# Persisted vector stores (Step 4 follow-up), one per chunking strategy (rag.<strategy>.db) - generated,
# derived entirely from data/, can grow large. rag.db* covers the pre-strategy single index.
rag.db
rag.db-shm
rag.db-wal
rag.db.manifest.json
rag.*.db
rag.*.db-shm
rag.*.db-wal
rag.*.db.manifest.json

# EDGAR extracted XBRL instances (<name>_htm.xml, 2-11 MB each): a test oracle only - FilingXbrlTests compares the
# reader against them when present and skips otherwise. Download from each filing's EDGAR "Data Files".
data/*_htm.xml

# Python bytecode (tools/rerank_spike.py imports tools/replay_recall.py)
__pycache__/

# v3 evaluation runs (eval/v3-runs/): the model-response cache is large and its keys aren't stable across
# Microsoft.Extensions.AI.Evaluation versions - regenerated by a run, never committed.
eval/v3-runs/cache/
# tools/run-variance.ps1's console logs - its results and summaries are stored like any run.
eval/v3-runs/logs/
