<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pipeline - chunking, XBRL, the index, retrieval, the prompt and the question loop - with no model provider
       in it: the app passes the embedder and chat client it was configured with (docs/Decision-Log.md, "Core and
       providers"). -->
