<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ollama as a provider: its clients, the readiness check and the chat model's thinking capability. Either app,
       and the evaluation, embeds or answers through it; Core never sees OllamaSharp. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RagFilingExplorer.Core\RagFilingExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>

</Project>
