<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike runner for the Linearized chunking strategy (see docs/Decision-Log.md). Deliberately not in
       RagFilingExplorer.slnx: it drives HtmlTableLinearizer over data/*.html and writes reports, it isn't
       part of the app or its test suite. Run from the repo root with: dotnet run, project tools/LinearizeSpike, one argument (output directory). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RagFilingExplorer.Local\RagFilingExplorer.Local.csproj" />
  </ItemGroup>

</Project>
