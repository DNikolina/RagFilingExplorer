{
  "Ollama": {
    "BaseUrl": "http://localhost:11434/",
    "TimeoutMinutes": 5,
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "llama3.1:8b"
  },
  "Chunking": {
    // Which chunking strategy builds (and answers from) the index: "Markdown" (the original: markitdown
    // tables, split with headers repeated) or "Linearized" (tables turned into self-contained row lines
    // from the HTML first). Each keeps its own rag.<strategy>.db and chunk-review/<strategy>/ dumps, so
    // switching back and forth doesn't force a rebuild once both exist.
    "Strategy": "Markdown",
    "TokenizerModel": "gpt-4",
    "MaxTokensPerChunk": 500,
    "OverlapTokens": 50
  },
  "VectorStore": {
    // Keep at 1 while CommunityToolkit.VectorData.SqliteVec is pinned to 1.0.1-preview (see the
    // .csproj): any multi-record UpsertAsync batch throws "UNIQUE constraint failed on vec_chunks
    // primary key" - a known upstream sqlite-vec bug already fixed in a newer native build the NuGet
    // package hasn't picked up. See README.md and docs/Decision-Log.md for the full story.
    "UpsertBatchSize": 1
  },
  "Retrieval": {
    "DefaultSearchTopK": 5,
    "VerboseSearchTopK": 25,
    "GenerationTopK": 5,
    "ChatTemperature": 0,
    // "Vector": one vector search, the question's statement type (if any) a hard filter - v1's retrieval, and
    // what the Markdown and Linearized strategies were measured with. "Hybrid" (v2 step 2): a vector search and an
    // SQLite FTS5 keyword search (bm25) fused by reciprocal rank fusion, the statement type a third, boosting list
    // instead of a filter - so a question routed to the wrong statement can still reach its answer. The company
    // filter stays hard in both. See docs/Decision-Log.md, "Step 2 - hybrid search".
    "Search": "Vector",
    // Hybrid only: how many candidates each list contributes before fusion. 50 matched fusing complete rankings on
    // every question group in the replay (100 did slightly worse on the routing tests); a filing has 199-294 chunks.
    "HybridCandidates": 50,
    // Hybrid only (v2 step 2b): rerank each company's top RerankCandidates with the cross-encoder in
    // RerankModelDirectory (ms-marco-MiniLM-L6-v2's onnx/model.onnx + vocab.txt, fetched separately - see
    // docs/Decision-Log.md, "Step 2b resumed"), whose model.onnx must match RerankModelSha256. 25 matched or beat 50
    // on every question group in the replay. Off by default, like Hybrid.
    "Rerank": false,
    "RerankCandidates": 25,
    "RerankModelDirectory": "%USERPROFILE%/models/cross-encoder/ms-marco-MiniLM-L6-v2",
    "RerankModelSha256": "5d3e70fd0c9ff14b9b5169a51e957b7a9c74897afd0a35ce4bd318150c1d4d4a",
    // One of Microsoft.Extensions.AI's ReasoningEffort enum names: None, Low, Medium, High, ExtraHigh.
    // Only applied to questions QueryIntentResolver.RequiresSynthesis flags as needing multi-step
    // reasoning (comparisons, ratios, trends) - a plain single-fact lookup always uses Effort.None
    // regardless of this value, so reasoning is never wasted on a task that doesn't need it. Safe to set
    // this to a non-None value even with a non-reasoning model like llama3.1:8b configured, but only
    // because RagAnswerService gates it on a real capability check (Ollama's own /api/show) before ever
    // sending a think request - Ollama hard-rejects one for a model that can't reason at all, confirmed
    // directly. See README.md for the investigation and RagAnswerService.AskAsync for the routing logic.
    "ReasoningEffort": "Medium",
    // Ceiling for the model's total output tokens (thinking + answer combined, for a reasoning model), for
    // every chat model - not only reasoning ones. The prompt and this output share Ollama's context window
    // (num_ctx, not set by this app: 4096 by default, confirmed in its server log), so prompt + this must
    // stay under 4096. It used to be 4096 on its own, which could never be honored: runaway llama3.1:8b
    // answers ran to 1,400-1,700 tokens, filled the window, and Ollama then dropped the oldest tokens -
    // the system prompt and top-ranked chunks. Real answers are at most ~275 tokens (p95 ~170) and prompts
    // at most ~3,000, so 768 is ~3x the longest answer with ~300 tokens to spare. A reasoning model gets
    // little room to think within this; giving it more means raising num_ctx too.
    "MaxOutputTokens": 768
  }
}
