<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app with Claude as its chat model (docs/Decision-Log.md, "paid services (v4)"): Local's chunking, index,
       retrieval and prompt, unchanged; only the model answering differs. Local itself references no paid service. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="claudesettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RagFilingExplorer.Local\RagFilingExplorer.Local.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.54.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>

</Project>
