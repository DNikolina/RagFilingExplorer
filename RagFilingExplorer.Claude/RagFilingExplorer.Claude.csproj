<Project Sdk="Microsoft.NET.Sdk">

  <!-- Claude as a chat provider (docs/Decision-Log.md, "paid services (v4)", "Core and providers"): the client and its
       settings, used when appsettings.json's Providers:Chat is Claude. A library - the app is RagFilingExplorer.Cli. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Where the API key can live outside the repository: dotnet user-secrets set Claude:ApiKey ... (ClaudeSettings).
         Kept on this library, not the app, so the app and the evaluation read the same key. -->
    <UserSecretsId>81881dfa-130d-4974-9078-2b1ca1becebe</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RagFilingExplorer.Core\RagFilingExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.54.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
  </ItemGroup>

</Project>
